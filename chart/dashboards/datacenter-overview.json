    {
      "datasource": {
        "type": "prometheus",
        "uid": "chantico-prometheus"
      },
      "description": "99th percentile of the actual Prometheus scrape interval (target: 10s).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3,
          "mappings": [
            {
              "options": {
                "from": 0,
                "result": {
                  "color": "green",
                  "index": 0,
                  "text": "On time"
                },
                "to": 10
              },
              "type": "range"
            },
            {
              "options": {
                "from": 10,
                "result": {
                  "color": "light-green",
                  "index": 1,
                  "text": "OK"
                },
                "to": 10.5
              },
              "type": "range"
            },
            {
              "options": {
                "from": 10.5,
                "result": {
                  "color": "yellow",
                  "index": 2,
                  "text": "Late"
                },
                "to": 11
              },
              "type": "range"
            },
            {
              "options": {
                "from": 11,
                "result": {
                  "color": "red",
                  "index": 3,
                  "text": "Slow"
                },
                "to": 60
              },
              "type": "range"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
